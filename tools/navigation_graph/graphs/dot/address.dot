digraph AddressModule {
    rankdir=TB;
    splines=spline;
    nodesep=0.55;
    ranksep=0.95;
    bgcolor="white";
    fontname="Helvetica";
    labelloc="t"; fontsize=20;
    label="Address";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.18,0.10", color="#D81B60", fillcolor="#FCE4EC"];
    edge [fontname="Helvetica", fontsize=8.5, color="#78909C", arrowsize=0.7, labeldistance=1.2];

    // External boundary nodes
    "LoadMultisigWalletDescriptorView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#757575", fontcolor="#757575"];
    "ScanView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#1E88E5", fontcolor="#1E88E5"];
    "SeedAddressVerificationView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#43A047", fontcolor="#43A047"];
    "SeedSelectSeedView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#43A047", fontcolor="#43A047"];
    "[BACK]" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];

    // Internal transitions
    "AddressVerificationStartView" -> "AddressVerificationSigTypeView" [label="controller.unverified_address['script_type']\n== NESTED_SEGWIT"];

    // Boundary transitions
    "ScanView" -> "AddressVerificationStartView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  NOT\n(decoder.is_seed)  AND  NOT (decoder.is_psbt)\nAND  NOT (decoder.is_settings)  AND  NOT\n(decoder.is_wallet_descriptor)  AND\ndecoder.is_address"];
    "AddressVerificationStartView" -> "SeedSelectSeedView" [style=dashed, color="#B0BEC5", label="controller.unverified_address['script_type']\n== LEGACY_P2PKH"];
    "AddressVerificationStartView" -> "SeedAddressVerificationView" [style=dashed, color="#B0BEC5", label="controller.unverified_address['script_type']\n== NATIVE_SEGWIT  AND\nlen(controller.unverified_address['address'])\n>= 62  AND\ncontroller.multisig_wallet_descriptor"];
    "AddressVerificationStartView" -> "LoadMultisigWalletDescriptorView" [style=dashed, color="#B0BEC5", label="controller.unverified_address['script_type']\n== NATIVE_SEGWIT  AND\nlen(controller.unverified_address['address'])\n>= 62  AND  NOT\n(controller.multisig_wallet_descriptor)"];
    "AddressVerificationStartView" -> "SeedSelectSeedView" [style=dashed, color="#B0BEC5", label="controller.unverified_address['script_type']\n== NATIVE_SEGWIT  AND  NOT\n(len(controller.unverified_address['address'])\n>= 62)"];
    "AddressVerificationStartView" -> "SeedSelectSeedView" [style=dashed, color="#B0BEC5", label="NOT\n(controller.unverified_address['script_type']\n== NATIVE_SEGWIT)  AND\ncontroller.unverified_address['script_type']\n== TAPROOT"];
    "AddressVerificationSigTypeView" -> "[BACK]" [style=dashed, color="#B0BEC5", label="selected_menu_num == RET_CODE__BACK_BUTTON"];
    "AddressVerificationSigTypeView" -> "SeedSelectSeedView" [style=dashed, color="#B0BEC5", label="NOT (selected_menu_num ==\nRET_CODE__BACK_BUTTON)  AND\nbutton_data[selected_menu_num] == SINGLE_SIG"];
    "AddressVerificationSigTypeView" -> "SeedAddressVerificationView" [style=dashed, color="#B0BEC5", label="NOT (selected_menu_num ==\nRET_CODE__BACK_BUTTON)  AND  NOT\n(button_data[selected_menu_num] == SINGLE_SIG)\nAND  button_data[selected_menu_num] ==\nMULTISIG  AND\ncontroller.multisig_wallet_descriptor"];
    "AddressVerificationSigTypeView" -> "LoadMultisigWalletDescriptorView" [style=dashed, color="#B0BEC5", label="NOT (selected_menu_num ==\nRET_CODE__BACK_BUTTON)  AND  NOT\n(button_data[selected_menu_num] == SINGLE_SIG)\nAND  button_data[selected_menu_num] ==\nMULTISIG  AND  NOT\n(controller.multisig_wallet_descriptor)"];
}