digraph ScanModule {
    rankdir=TB;
    splines=spline;
    nodesep=0.55;
    ranksep=0.95;
    bgcolor="white";
    fontname="Helvetica";
    labelloc="t"; fontsize=20;
    label="Scan";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.18,0.10", color="#1E88E5", fillcolor="#E3F2FD"];
    edge [fontname="Helvetica", fontsize=8.5, color="#78909C", arrowsize=0.7, labeldistance=1.2];

    // External boundary nodes
    "AddressVerificationStartView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#D81B60", fontcolor="#D81B60"];
    "ErrorView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];
    "LoadMultisigWalletDescriptorView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#757575", fontcolor="#757575"];
    "LoadSeedView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#757575", fontcolor="#757575"];
    "MainMenuView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];
    "MultisigWalletDescriptorView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#757575", fontcolor="#757575"];
    "NotYetImplementedView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];
    "PSBTSelectSeedView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#FB8C00", fontcolor="#FB8C00"];
    "SeedAddPassphraseView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#43A047", fontcolor="#43A047"];
    "SeedFinalizeView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#43A047", fontcolor="#43A047"];
    "SeedOptionsView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#43A047", fontcolor="#43A047"];
    "SeedSelectSeedView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#43A047", fontcolor="#43A047"];
    "SeedSignMessageStartView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#43A047", fontcolor="#43A047"];
    "SettingsIngestSettingsQRView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#8E24AA", fontcolor="#8E24AA"];
    "ToolsAddressExplorerSelectSourceView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#00ACC1", fontcolor="#00ACC1"];
    "ToolsMenuView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#00ACC1", fontcolor="#00ACC1"];
    "[BACK]" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];

    // Internal transitions
    "ScanView" -> "ScanInvalidQRTypeView" [label="NOT (decoder.is_complete)  AND\ndecoder.is_invalid"];

    // Boundary transitions
    "ScanView" -> "ErrorView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  not is_valid_qr_type"];
    "ScanView" -> "[BACK]" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  not is_valid_qr_type"];
    "ScanView" -> "NotYetImplementedView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  decoder.is_seed  AND\nnot seed_mnemonic"];
    "ScanView" -> "SeedAddPassphraseView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  decoder.is_seed  AND\nNOT (not seed_mnemonic)  AND\nsettings.get_value(SETTING__PASSPHRASE) ==\nOPTION__REQUIRED"];
    "ScanView" -> "SeedFinalizeView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  decoder.is_seed  AND\nNOT (not seed_mnemonic)  AND  NOT\n(settings.get_value(SETTING__PASSPHRASE) ==\nOPTION__REQUIRED)"];
    "ScanView" -> "PSBTSelectSeedView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  NOT\n(decoder.is_seed)  AND  decoder.is_psbt"];
    "ScanView" -> "SettingsIngestSettingsQRView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  NOT\n(decoder.is_seed)  AND  NOT (decoder.is_psbt)\nAND  decoder.is_settings"];
    "ScanView" -> "NotYetImplementedView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  NOT\n(decoder.is_seed)  AND  NOT (decoder.is_psbt)\nAND  NOT (decoder.is_settings)  AND\ndecoder.is_wallet_descriptor  AND  not\ndescriptor.is_basic_multisig"];
    "ScanView" -> "MultisigWalletDescriptorView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  NOT\n(decoder.is_seed)  AND  NOT (decoder.is_psbt)\nAND  NOT (decoder.is_settings)  AND\ndecoder.is_wallet_descriptor"];
    "ScanView" -> "AddressVerificationStartView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  NOT\n(decoder.is_seed)  AND  NOT (decoder.is_psbt)\nAND  NOT (decoder.is_settings)  AND  NOT\n(decoder.is_wallet_descriptor)  AND\ndecoder.is_address"];
    "ScanView" -> "SeedSignMessageStartView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  NOT\n(decoder.is_seed)  AND  NOT (decoder.is_psbt)\nAND  NOT (decoder.is_settings)  AND  NOT\n(decoder.is_wallet_descriptor)  AND  NOT\n(decoder.is_address)  AND\ndecoder.is_sign_message"];
    "ScanView" -> "NotYetImplementedView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  NOT\n(decoder.is_seed)  AND  NOT (decoder.is_psbt)\nAND  NOT (decoder.is_settings)  AND  NOT\n(decoder.is_wallet_descriptor)  AND  NOT\n(decoder.is_address)  AND  NOT\n(decoder.is_sign_message)"];
    "ScanView" -> "MainMenuView" [style=dashed, color="#B0BEC5"];
    "ScanInvalidQRTypeView" -> "MainMenuView" [style=dashed, color="#B0BEC5"];
    "PSBTSelectSeedView" -> "ScanSeedQRView" [style=dashed, color="#B0BEC5", label="button_data[selected_menu_num] == SCAN_SEED"];
    "ToolsMenuView" -> "ScanAddressView" [style=dashed, color="#B0BEC5", label="NOT (selected_menu_num ==\nRET_CODE__BACK_BUTTON)  AND  NOT\n(button_data[selected_menu_num] == IMAGE)  AND\nNOT (button_data[selected_menu_num] == DICE)\nAND  NOT (button_data[selected_menu_num] ==\nKEYBOARD)  AND  NOT\n(button_data[selected_menu_num] ==\nADDRESS_EXPLORER)  AND\nbutton_data[selected_menu_num] ==\nVERIFY_ADDRESS"];
    "ToolsAddressExplorerSelectSourceView" -> "ScanSeedQRView" [style=dashed, color="#B0BEC5", label="NOT (len(seeds) > 0 and selected_menu_num <\nlen(seeds))  AND\nbutton_data[selected_menu_num] == SCAN_SEED"];
    "ToolsAddressExplorerSelectSourceView" -> "ScanWalletDescriptorView" [style=dashed, color="#B0BEC5", label="NOT (len(seeds) > 0 and selected_menu_num <\nlen(seeds))  AND  NOT\n(button_data[selected_menu_num] == SCAN_SEED)\nAND  button_data[selected_menu_num] ==\nSCAN_DESCRIPTOR"];
    "MainMenuView" -> "ScanView" [style=dashed, color="#B0BEC5", label="button_data[selected_menu_num] == SCAN"];
    "SeedSelectSeedView" -> "ScanView" [style=dashed, color="#B0BEC5", label="button_data[selected_menu_num] == SCAN_SEED"];
    "LoadSeedView" -> "ScanSeedQRView" [style=dashed, color="#B0BEC5", label="button_data[selected_menu_num] == SEED_QR"];
    "SeedOptionsView" -> "ScanPSBTView" [style=dashed, color="#B0BEC5", label="button_data[selected_menu_num] == SCAN_PSBT"];
    "SeedOptionsView" -> "ScanView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] ==\nSCAN_PSBT)  AND  NOT\n(button_data[selected_menu_num] ==\nEXPORT_XPUB)  AND  NOT\n(button_data[selected_menu_num] == EXPLORER)\nAND  button_data[selected_menu_num] ==\nSIGN_MESSAGE"];
    "LoadMultisigWalletDescriptorView" -> "ScanWalletDescriptorView" [style=dashed, color="#B0BEC5", label="button_data[selected_menu_num] == SCAN"];
}