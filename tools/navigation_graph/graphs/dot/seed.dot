digraph SeedModule {
    rankdir=TB;
    splines=spline;
    nodesep=0.55;
    ranksep=0.95;
    bgcolor="white";
    fontname="Helvetica";
    labelloc="t"; fontsize=20;
    label="Seed";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.18,0.10", color="#43A047", fillcolor="#E8F5E9"];
    edge [fontname="Helvetica", fontsize=8.5, color="#78909C", arrowsize=0.7, labeldistance=1.2];

    // External boundary nodes
    "AddressVerificationSigTypeView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#D81B60", fontcolor="#D81B60"];
    "AddressVerificationStartView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#D81B60", fontcolor="#D81B60"];
    "LoadSeedView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#757575", fontcolor="#757575"];
    "MainMenuView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];
    "MultisigWalletDescriptorView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#757575", fontcolor="#757575"];
    "NetworkMismatchErrorView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];
    "NotYetImplementedView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];
    "OptionDisabledView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];
    "PSBTOverviewView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#FB8C00", fontcolor="#FB8C00"];
    "PSBTSelectSeedView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#FB8C00", fontcolor="#FB8C00"];
    "ScanPSBTView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#1E88E5", fontcolor="#1E88E5"];
    "ScanView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#1E88E5", fontcolor="#1E88E5"];
    "ToolsAddressExplorerAddressTypeView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#00ACC1", fontcolor="#00ACC1"];
    "ToolsAddressExplorerSelectSourceView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#00ACC1", fontcolor="#00ACC1"];
    "ToolsCalcFinalWordDoneView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#00ACC1", fontcolor="#00ACC1"];
    "ToolsCalcFinalWordFinalizePromptView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#00ACC1", fontcolor="#00ACC1"];
    "ToolsCalcFinalWordNumWordsView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#00ACC1", fontcolor="#00ACC1"];
    "ToolsCalcFinalWordShowFinalWordView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#00ACC1", fontcolor="#00ACC1"];
    "ToolsDiceEntropyEntryView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#00ACC1", fontcolor="#00ACC1"];
    "ToolsImageEntropyMnemonicLengthView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#00ACC1", fontcolor="#00ACC1"];
    "[BACK]" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];

    // Internal transitions
    "SeedsMenuView" -> "SeedOptionsView" [label="NOT (selected_menu_num ==\nRET_CODE__BACK_BUTTON)  AND  len(seeds) > 0\nand selected_menu_num < len(seeds)"];
    "SeedSelectSeedView" -> "SeedAddressVerificationView" [label="len(seeds) > 0 and selected_menu_num <\nlen(seeds)  AND  flow ==\nController.FLOW__VERIFY_SINGLESIG_ADDR"];
    "SeedSelectSeedView" -> "SeedSignMessageConfirmMessageView" [label="len(seeds) > 0 and selected_menu_num <\nlen(seeds)  AND  NOT (flow ==\nController.FLOW__VERIFY_SINGLESIG_ADDR)  AND\nflow == Controller.FLOW__SIGN_MESSAGE"];
    "SeedSelectSeedView" -> "SeedMnemonicEntryView" [label="NOT (button_data[selected_menu_num] ==\nSCAN_SEED)  AND\nbutton_data[selected_menu_num] in\n[TYPE_12WORD, TYPE_24WORD]"];
    "SeedSelectSeedView" -> "SeedElectrumMnemonicStartView" [label="NOT (button_data[selected_menu_num] ==\nSCAN_SEED)  AND  NOT\n(button_data[selected_menu_num] in\n[TYPE_12WORD, TYPE_24WORD])  AND\nbutton_data[selected_menu_num] ==\nTYPE_ELECTRUM"];
    "SeedMnemonicEntryView" -> "SeedMnemonicEntryView" [label="cur_word_index <\ncontroller.storage.pending_mnemonic_length - 1", style=dashed, color="#B0BEC5"];
    "SeedMnemonicEntryView" -> "SeedMnemonicInvalidView" [label="NOT (cur_word_index <\ncontroller.storage.pending_mnemonic_length -\n1)"];
    "SeedMnemonicEntryView" -> "SeedFinalizeView" [label="NOT (cur_word_index <\ncontroller.storage.pending_mnemonic_length -\n1)"];
    "SeedMnemonicInvalidView" -> "SeedMnemonicEntryView" [label="button_data[selected_menu_num] == EDIT"];
    "SeedFinalizeView" -> "SeedOptionsView" [label="button_data[selected_menu_num] == FINALIZE"];
    "SeedFinalizeView" -> "SeedAddPassphraseView" [label="NOT (button_data[selected_menu_num] ==\nFINALIZE)  AND  button_data[selected_menu_num]\n== PASSPHRASE"];
    "SeedAddPassphraseView" -> "SeedAddPassphraseExitDialogView" [label="'is_back_button' in ret_dict or\nlen(seed.passphrase) == 0"];
    "SeedAddPassphraseView" -> "SeedReviewPassphraseView" [label="NOT ('is_back_button' in ret_dict or\nlen(seed.passphrase) == 0)"];
    "SeedAddPassphraseExitDialogView" -> "SeedAddPassphraseView" [label="button_data[selected_menu_num] == EDIT"];
    "SeedAddPassphraseExitDialogView" -> "SeedFinalizeView" [label="NOT (button_data[selected_menu_num] == EDIT)\nAND  button_data[selected_menu_num] in\n[DISCARD, SKIP]"];
    "SeedReviewPassphraseView" -> "SeedAddPassphraseView" [label="button_data[selected_menu_num] == EDIT"];
    "SeedReviewPassphraseView" -> "SeedOptionsView" [label="NOT (button_data[selected_menu_num] == EDIT)\nAND  button_data[selected_menu_num] == DONE"];
    "SeedDiscardView" -> "SeedOptionsView" [label="button_data[selected_menu_num] == KEEP  AND\nseed_num is not None"];
    "SeedDiscardView" -> "SeedFinalizeView" [label="button_data[selected_menu_num] == KEEP  AND\nNOT (seed_num is not None)"];
    "SeedElectrumMnemonicStartView" -> "SeedMnemonicEntryView" [];
    "SeedOptionsView" -> "SeedAddressVerificationView" [label="controller.unverified_address  AND\ncontroller.resume_main_flow ==\nController.FLOW__VERIFY_SINGLESIG_ADDR"];
    "SeedOptionsView" -> "SeedExportXpubScriptTypeView" [label="controller.resume_main_flow ==\nController.FLOW__ADDRESS_EXPLORER"];
    "SeedOptionsView" -> "SeedSignMessageConfirmMessageView" [label="NOT (controller.resume_main_flow ==\nController.FLOW__ADDRESS_EXPLORER)  AND\ncontroller.resume_main_flow ==\nController.FLOW__SIGN_MESSAGE"];
    "SeedOptionsView" -> "SeedExportXpubSigTypeView" [label="NOT (button_data[selected_menu_num] ==\nSCAN_PSBT)  AND\nbutton_data[selected_menu_num] == EXPORT_XPUB"];
    "SeedOptionsView" -> "SeedExportXpubScriptTypeView" [label="NOT (button_data[selected_menu_num] ==\nSCAN_PSBT)  AND  NOT\n(button_data[selected_menu_num] ==\nEXPORT_XPUB)  AND\nbutton_data[selected_menu_num] == EXPLORER"];
    "SeedOptionsView" -> "SeedBackupView" [label="NOT (button_data[selected_menu_num] ==\nSCAN_PSBT)  AND  NOT\n(button_data[selected_menu_num] ==\nEXPORT_XPUB)  AND  NOT\n(button_data[selected_menu_num] == EXPLORER)\nAND  NOT (button_data[selected_menu_num] ==\nSIGN_MESSAGE)  AND\nbutton_data[selected_menu_num] == BACKUP"];
    "SeedOptionsView" -> "SeedBIP85SelectNumWordsView" [label="NOT (button_data[selected_menu_num] ==\nSCAN_PSBT)  AND  NOT\n(button_data[selected_menu_num] ==\nEXPORT_XPUB)  AND  NOT\n(button_data[selected_menu_num] == EXPLORER)\nAND  NOT (button_data[selected_menu_num] ==\nSIGN_MESSAGE)  AND  NOT\n(button_data[selected_menu_num] == BACKUP)\nAND  button_data[selected_menu_num] ==\nBIP85_CHILD_SEED"];
    "SeedOptionsView" -> "SeedDiscardView" [label="NOT (button_data[selected_menu_num] ==\nSCAN_PSBT)  AND  NOT\n(button_data[selected_menu_num] ==\nEXPORT_XPUB)  AND  NOT\n(button_data[selected_menu_num] == EXPLORER)\nAND  NOT (button_data[selected_menu_num] ==\nSIGN_MESSAGE)  AND  NOT\n(button_data[selected_menu_num] == BACKUP)\nAND  NOT (button_data[selected_menu_num] ==\nBIP85_CHILD_SEED)  AND\nbutton_data[selected_menu_num] == DISCARD"];
    "SeedBackupView" -> "SeedWordsWarningView" [label="NOT (selected_menu_num ==\nRET_CODE__BACK_BUTTON)  AND\nbutton_data[selected_menu_num] == VIEW_WORDS"];
    "SeedBackupView" -> "SeedTranscribeSeedQRFormatView" [label="NOT (selected_menu_num ==\nRET_CODE__BACK_BUTTON)  AND  NOT\n(button_data[selected_menu_num] == VIEW_WORDS)\nAND  button_data[selected_menu_num] ==\nEXPORT_SEEDQR"];
    "SeedExportXpubSigTypeView" -> "SeedExportXpubScriptTypeView" [label="len(settings.get_value(SETTING__SIG_TYPES)) ==\n1"];
    "SeedExportXpubSigTypeView" -> "SeedExportXpubScriptTypeView" [];
    "SeedExportXpubScriptTypeView" -> "SeedExportXpubQRFormatView" [label="len(script_types) == 1  AND  NOT\n(controller.resume_main_flow ==\nController.FLOW__ADDRESS_EXPLORER)"];
    "SeedExportXpubScriptTypeView" -> "SeedExportXpubCustomDerivationView" [label="NOT (selected_menu_num ==\nRET_CODE__BACK_BUTTON)  AND\nargs['script_type'] == CUSTOM_DERIVATION"];
    "SeedExportXpubScriptTypeView" -> "SeedExportXpubQRFormatView" [label="NOT (selected_menu_num ==\nRET_CODE__BACK_BUTTON)  AND  NOT\n(controller.resume_main_flow ==\nController.FLOW__ADDRESS_EXPLORER)"];
    "SeedExportXpubCustomDerivationView" -> "SeedExportXpubQRFormatView" [];
    "SeedExportXpubQRFormatView" -> "SeedExportXpubWarningView" [label="len(settings.get_value(SETTING__XPUB_QR_FORMAT))\n== 1"];
    "SeedExportXpubQRFormatView" -> "SeedExportXpubWarningView" [];
    "SeedExportXpubWarningView" -> "SeedExportXpubDetailsView" [];
    "SeedExportXpubDetailsView" -> "SeedExportXpubQRDisplayView" [label="selected_menu_num == 0"];
    "SeedWordsWarningView" -> "SeedWordsView" [];
    "SeedWordsView" -> "SeedWordsBackupTestPromptView" [label="button_data[selected_menu_num] == NEXT  AND\nseed_num is None and page_index == num_pages -\n1"];
    "SeedWordsView" -> "SeedWordsView" [label="button_data[selected_menu_num] == NEXT  AND\nNOT (seed_num is None and page_index ==\nnum_pages - 1)", style=dashed, color="#B0BEC5"];
    "SeedWordsView" -> "SeedWordsBackupTestPromptView" [label="NOT (button_data[selected_menu_num] == NEXT)\nAND  button_data[selected_menu_num] == DONE"];
    "SeedBIP85SelectNumWordsView" -> "SeedBIP85SelectChildIndexView" [];
    "SeedBIP85SelectChildIndexView" -> "SeedBIP85InvalidChildIndexView" [label="not 0 <= int(ret) < 2 ** 31"];
    "SeedBIP85SelectChildIndexView" -> "SeedWordsWarningView" [];
    "SeedBIP85InvalidChildIndexView" -> "SeedBIP85SelectChildIndexView" [];
    "SeedWordsBackupTestPromptView" -> "SeedWordsBackupTestView" [label="button_data[selected_menu_num] == VERIFY"];
    "SeedWordsBackupTestPromptView" -> "SeedOptionsView" [label="NOT (button_data[selected_menu_num] == VERIFY)\nAND  button_data[selected_menu_num] == SKIP\nAND  seed_num is not None"];
    "SeedWordsBackupTestPromptView" -> "SeedFinalizeView" [label="NOT (button_data[selected_menu_num] == VERIFY)\nAND  button_data[selected_menu_num] == SKIP\nAND  NOT (seed_num is not None)"];
    "SeedWordsBackupTestView" -> "SeedWordsBackupTestSuccessView" [label="button_data[selected_menu_num] == real_word\nAND  len(confirmed_list) == len(mnemonic_list)"];
    "SeedWordsBackupTestView" -> "SeedWordsBackupTestView" [label="button_data[selected_menu_num] == real_word\nAND  NOT (len(confirmed_list) ==\nlen(mnemonic_list))", style=dashed, color="#B0BEC5"];
    "SeedWordsBackupTestView" -> "SeedWordsBackupTestMistakeView" [label="NOT (button_data[selected_menu_num] ==\nreal_word)"];
    "SeedWordsBackupTestMistakeView" -> "SeedWordsView" [label="button_data[selected_menu_num] == REVIEW"];
    "SeedWordsBackupTestMistakeView" -> "SeedWordsBackupTestView" [label="NOT (button_data[selected_menu_num] == REVIEW)\nAND  button_data[selected_menu_num] == RETRY"];
    "SeedWordsBackupTestSuccessView" -> "SeedOptionsView" [label="seed_num is not None"];
    "SeedWordsBackupTestSuccessView" -> "SeedFinalizeView" [label="NOT (seed_num is not None)"];
    "SeedTranscribeSeedQRFormatView" -> "SeedTranscribeSeedQRWarningView" [label="settings.get_value(SETTING__COMPACT_SEEDQR) !=\nOPTION__ENABLED"];
    "SeedTranscribeSeedQRFormatView" -> "SeedTranscribeSeedQRWarningView" [];
    "SeedTranscribeSeedQRWarningView" -> "SeedTranscribeSeedQRWholeQRView" [];
    "SeedTranscribeSeedQRWholeQRView" -> "SeedTranscribeSeedQRZoomedInView" [label="NOT (ret == RET_CODE__BACK_BUTTON)"];
    "SeedTranscribeSeedQRZoomedInView" -> "SeedTranscribeSeedQRConfirmQRPromptView" [];
    "SeedTranscribeSeedQRConfirmQRPromptView" -> "SeedTranscribeSeedQRConfirmScanView" [label="NOT (selected_menu_option ==\nRET_CODE__BACK_BUTTON)  AND\nbutton_data[selected_menu_option] == SCAN"];
    "SeedTranscribeSeedQRConfirmQRPromptView" -> "SeedOptionsView" [label="NOT (selected_menu_option ==\nRET_CODE__BACK_BUTTON)  AND  NOT\n(button_data[selected_menu_option] == SCAN)\nAND  button_data[selected_menu_option] == DONE"];
    "SeedTranscribeSeedQRConfirmScanView" -> "SeedTranscribeSeedQRConfirmWrongSeedView" [label="decoder.is_complete  AND  decoder.is_seed  AND\nseed_mnemonic != seed.mnemonic_list"];
    "SeedTranscribeSeedQRConfirmScanView" -> "SeedTranscribeSeedQRConfirmSuccessView" [label="decoder.is_complete  AND  decoder.is_seed  AND\nNOT (seed_mnemonic != seed.mnemonic_list)"];
    "SeedTranscribeSeedQRConfirmScanView" -> "SeedTranscribeSeedQRConfirmInvalidQRView" [];
    "SeedTranscribeSeedQRConfirmSuccessView" -> "SeedOptionsView" [];
    "SeedAddressVerificationView" -> "SeedAddressVerificationSuccessView" [label="verified_index.cur_count is not None"];
    "SeedSignMessageStartView" -> "SeedSignMessageConfirmMessageView" [label="seed_num is not None"];
    "SeedSignMessageStartView" -> "SeedSelectSeedView" [label="NOT (seed_num is not None)"];
    "SeedSignMessageConfirmMessageView" -> "SeedSignMessageConfirmAddressView" [label="page_num ==\nlen(controller.sign_message_data['paged_message'])\n- 1"];
    "SeedSignMessageConfirmMessageView" -> "SeedSignMessageConfirmMessageView" [label="NOT (page_num ==\nlen(controller.sign_message_data['paged_message'])\n- 1)", style=dashed, color="#B0BEC5"];
    "SeedSignMessageConfirmAddressView" -> "SeedSignMessageSignedMessageQRView" [];

    // Boundary transitions
    "ScanView" -> "SeedAddPassphraseView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  decoder.is_seed  AND\nNOT (not seed_mnemonic)  AND\nsettings.get_value(SETTING__PASSPHRASE) ==\nOPTION__REQUIRED"];
    "ScanView" -> "SeedFinalizeView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  decoder.is_seed  AND\nNOT (not seed_mnemonic)  AND  NOT\n(settings.get_value(SETTING__PASSPHRASE) ==\nOPTION__REQUIRED)"];
    "ScanView" -> "SeedSignMessageStartView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  NOT\n(decoder.is_seed)  AND  NOT (decoder.is_psbt)\nAND  NOT (decoder.is_settings)  AND  NOT\n(decoder.is_wallet_descriptor)  AND  NOT\n(decoder.is_address)  AND\ndecoder.is_sign_message"];
    "PSBTSelectSeedView" -> "SeedMnemonicEntryView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] ==\nSCAN_SEED)  AND\nbutton_data[selected_menu_num] in\n[TYPE_12WORD, TYPE_24WORD]"];
    "PSBTSelectSeedView" -> "SeedElectrumMnemonicStartView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] ==\nSCAN_SEED)  AND  NOT\n(button_data[selected_menu_num] in\n[TYPE_12WORD, TYPE_24WORD])  AND\nbutton_data[selected_menu_num] ==\nTYPE_ELECTRUM"];
    "ToolsImageEntropyMnemonicLengthView" -> "SeedWordsWarningView" [style=dashed, color="#B0BEC5"];
    "ToolsDiceEntropyEntryView" -> "SeedWordsWarningView" [style=dashed, color="#B0BEC5"];
    "ToolsCalcFinalWordNumWordsView" -> "SeedMnemonicEntryView" [style=dashed, color="#B0BEC5"];
    "ToolsCalcFinalWordFinalizePromptView" -> "SeedMnemonicEntryView" [style=dashed, color="#B0BEC5", label="NOT (selected_menu_num ==\nRET_CODE__BACK_BUTTON)  AND  NOT\n(button_data[selected_menu_num] == COIN_FLIPS)\nAND  button_data[selected_menu_num] ==\nSELECT_WORD"];
    "ToolsCalcFinalWordDoneView" -> "SeedFinalizeView" [style=dashed, color="#B0BEC5", label="button_data[selected_menu_num] == LOAD"];
    "ToolsCalcFinalWordDoneView" -> "SeedDiscardView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] == LOAD)\nAND  button_data[selected_menu_num] == DISCARD"];
    "ToolsAddressExplorerSelectSourceView" -> "SeedExportXpubScriptTypeView" [style=dashed, color="#B0BEC5", label="len(seeds) > 0 and selected_menu_num <\nlen(seeds)"];
    "ToolsAddressExplorerSelectSourceView" -> "SeedMnemonicEntryView" [style=dashed, color="#B0BEC5", label="NOT (len(seeds) > 0 and selected_menu_num <\nlen(seeds))  AND  NOT\n(button_data[selected_menu_num] == SCAN_SEED)\nAND  NOT (button_data[selected_menu_num] ==\nSCAN_DESCRIPTOR)  AND\nbutton_data[selected_menu_num] in\n[TYPE_12WORD, TYPE_24WORD]"];
    "ToolsAddressExplorerSelectSourceView" -> "SeedElectrumMnemonicStartView" [style=dashed, color="#B0BEC5", label="NOT (len(seeds) > 0 and selected_menu_num <\nlen(seeds))  AND  NOT\n(button_data[selected_menu_num] == SCAN_SEED)\nAND  NOT (button_data[selected_menu_num] ==\nSCAN_DESCRIPTOR)  AND  NOT\n(button_data[selected_menu_num] in\n[TYPE_12WORD, TYPE_24WORD])  AND\nbutton_data[selected_menu_num] ==\nTYPE_ELECTRUM"];
    "MainMenuView" -> "SeedsMenuView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] == SCAN)\nAND  button_data[selected_menu_num] == SEEDS"];
    "SeedsMenuView" -> "LoadSeedView" [style=dashed, color="#B0BEC5", label="not seeds"];
    "SeedsMenuView" -> "[BACK]" [style=dashed, color="#B0BEC5", label="selected_menu_num == RET_CODE__BACK_BUTTON"];
    "SeedsMenuView" -> "LoadSeedView" [style=dashed, color="#B0BEC5", label="NOT (selected_menu_num ==\nRET_CODE__BACK_BUTTON)  AND  NOT (len(seeds) >\n0 and selected_menu_num < len(seeds))  AND\nbutton_data[selected_menu_num] == LOAD"];
    "SeedSelectSeedView" -> "[BACK]" [style=dashed, color="#B0BEC5", label="selected_menu_num == RET_CODE__BACK_BUTTON"];
    "SeedSelectSeedView" -> "ScanView" [style=dashed, color="#B0BEC5", label="button_data[selected_menu_num] == SCAN_SEED"];
    "LoadSeedView" -> "SeedMnemonicEntryView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] ==\nSEED_QR)  AND  button_data[selected_menu_num]\n== TYPE_12WORD"];
    "LoadSeedView" -> "SeedMnemonicEntryView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] ==\nSEED_QR)  AND  NOT\n(button_data[selected_menu_num] ==\nTYPE_12WORD)  AND\nbutton_data[selected_menu_num] == TYPE_24WORD"];
    "LoadSeedView" -> "SeedElectrumMnemonicStartView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] ==\nSEED_QR)  AND  NOT\n(button_data[selected_menu_num] ==\nTYPE_12WORD)  AND  NOT\n(button_data[selected_menu_num] ==\nTYPE_24WORD)  AND\nbutton_data[selected_menu_num] ==\nTYPE_ELECTRUM"];
    "SeedMnemonicEntryView" -> "[BACK]" [style=dashed, color="#B0BEC5", label="ret == RET_CODE__BACK_BUTTON  AND\ncur_word_index > 0"];
    "SeedMnemonicEntryView" -> "MainMenuView" [style=dashed, color="#B0BEC5", label="ret == RET_CODE__BACK_BUTTON  AND  NOT\n(cur_word_index > 0)"];
    "SeedMnemonicEntryView" -> "ToolsCalcFinalWordFinalizePromptView" [style=dashed, color="#B0BEC5", label="is_calc_final_word and cur_word_index ==\ncontroller.storage.pending_mnemonic_length - 2"];
    "SeedMnemonicEntryView" -> "ToolsCalcFinalWordShowFinalWordView" [style=dashed, color="#B0BEC5", label="is_calc_final_word and cur_word_index ==\ncontroller.storage.pending_mnemonic_length - 1"];
    "SeedMnemonicInvalidView" -> "MainMenuView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] == EDIT)\nAND  button_data[selected_menu_num] == DISCARD"];
    "SeedFinalizeView" -> "[BACK]" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] ==\nFINALIZE)  AND  NOT\n(button_data[selected_menu_num] == PASSPHRASE)\nAND  selected_menu_num ==\nRET_CODE__BACK_BUTTON"];
    "SeedDiscardView" -> "MainMenuView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] == KEEP)\nAND  button_data[selected_menu_num] == DISCARD"];
    "SeedOptionsView" -> "PSBTOverviewView" [style=dashed, color="#B0BEC5", label="controller.psbt  AND\nPSBTParser.has_matching_input_fingerprint(controller.psbt,\nseed,\nnetwork=settings.get_value(SETTING__NETWORK))\nAND  controller.resume_main_flow and\ncontroller.resume_main_flow ==\nController.FLOW__PSBT"];
    "SeedOptionsView" -> "MainMenuView" [style=dashed, color="#B0BEC5", label="selected_menu_num == RET_CODE__BACK_BUTTON"];
    "SeedOptionsView" -> "ScanPSBTView" [style=dashed, color="#B0BEC5", label="button_data[selected_menu_num] == SCAN_PSBT"];
    "SeedOptionsView" -> "ScanView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] ==\nSCAN_PSBT)  AND  NOT\n(button_data[selected_menu_num] ==\nEXPORT_XPUB)  AND  NOT\n(button_data[selected_menu_num] == EXPLORER)\nAND  button_data[selected_menu_num] ==\nSIGN_MESSAGE"];
    "SeedBackupView" -> "[BACK]" [style=dashed, color="#B0BEC5", label="selected_menu_num == RET_CODE__BACK_BUTTON"];
    "SeedExportXpubSigTypeView" -> "[BACK]" [style=dashed, color="#B0BEC5", label="selected_menu_num == RET_CODE__BACK_BUTTON"];
    "SeedExportXpubScriptTypeView" -> "ToolsAddressExplorerAddressTypeView" [style=dashed, color="#B0BEC5", label="len(script_types) == 1  AND\ncontroller.resume_main_flow ==\nController.FLOW__ADDRESS_EXPLORER"];
    "SeedExportXpubScriptTypeView" -> "[BACK]" [style=dashed, color="#B0BEC5", label="selected_menu_num == RET_CODE__BACK_BUTTON"];
    "SeedExportXpubScriptTypeView" -> "ToolsAddressExplorerAddressTypeView" [style=dashed, color="#B0BEC5", label="NOT (selected_menu_num ==\nRET_CODE__BACK_BUTTON)  AND\ncontroller.resume_main_flow ==\nController.FLOW__ADDRESS_EXPLORER"];
    "SeedExportXpubCustomDerivationView" -> "[BACK]" [style=dashed, color="#B0BEC5", label="ret == RET_CODE__BACK_BUTTON"];
    "SeedExportXpubCustomDerivationView" -> "ToolsAddressExplorerAddressTypeView" [style=dashed, color="#B0BEC5", label="controller.resume_main_flow ==\nController.FLOW__ADDRESS_EXPLORER"];
