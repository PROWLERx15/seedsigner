digraph SettingsModule {
    rankdir=TB;
    splines=spline;
    nodesep=0.55;
    ranksep=0.95;
    bgcolor="white";
    fontname="Helvetica";
    labelloc="t"; fontsize=20;
    label="Settings";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.18,0.10", color="#8E24AA", fillcolor="#F3E5F5"];
    edge [fontname="Helvetica", fontsize=8.5, color="#78909C", arrowsize=0.7, labeldistance=1.2];

    // External boundary nodes
    "DonateView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];
    "IOTestView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];
    "MainMenuView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];
    "NetworkMismatchErrorView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];
    "OptionDisabledView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];
    "RemoveMicroSDWarningView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];
    "ScanView" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#1E88E5", fontcolor="#1E88E5"];
    "blocking_view" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];
    "unblocking_view" [style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#F9A825", fontcolor="#F9A825"];

    // Internal transitions
    "SettingsMenuView" -> "SettingsMenuView" [label="visibility == VISIBILITY__GENERAL", style=dashed, color="#B0BEC5"];
    "SettingsMenuView" -> "SettingsMenuView" [label="NOT (visibility == VISIBILITY__GENERAL)  AND\nvisibility == VISIBILITY__ADVANCED", style=dashed, color="#B0BEC5"];
    "SettingsMenuView" -> "SettingsMenuView" [label="selected_menu_num == RET_CODE__BACK_BUTTON\nAND  NOT (visibility == VISIBILITY__GENERAL)\nAND  visibility == VISIBILITY__ADVANCED", style=dashed, color="#B0BEC5"];
    "SettingsMenuView" -> "SettingsMenuView" [label="selected_menu_num == RET_CODE__BACK_BUTTON\nAND  NOT (visibility == VISIBILITY__GENERAL)\nAND  NOT (visibility == VISIBILITY__ADVANCED)", style=dashed, color="#B0BEC5"];
    "SettingsMenuView" -> "LocaleSelectionView" [label="NOT (button_data[selected_menu_num] ==\nADVANCED)  AND  NOT\n(button_data[selected_menu_num] == HARDWARE)\nAND  NOT (button_data[selected_menu_num] ==\nIO_TEST)  AND  NOT\n(button_data[selected_menu_num] == DONATE)\nAND\nsettings_entries[selected_menu_num].attr_name\n== SETTING__LOCALE"];
    "SettingsMenuView" -> "SettingsEntryUpdateSelectionView" [label="NOT (button_data[selected_menu_num] ==\nADVANCED)  AND  NOT\n(button_data[selected_menu_num] == HARDWARE)\nAND  NOT (button_data[selected_menu_num] ==\nIO_TEST)  AND  NOT\n(button_data[selected_menu_num] == DONATE)\nAND  NOT\n(settings_entries[selected_menu_num].attr_name\n== SETTING__LOCALE)"];
    "LocaleSelectionView" -> "SettingsMenuView" [label="selected_menu_num == RET_CODE__BACK_BUTTON"];
    "LocaleSelectionView" -> "SettingsMenuView" [];
    "SettingsEntryUpdateSelectionView" -> "SettingsMenuView" [];
    "SettingsEntryUpdateSelectionView" -> "SettingsSelectionRequiredWarningView" [label="ret_value == RET_CODE__BACK_BUTTON  AND\nsettings_entry.type == TYPE__MULTISELECT  AND\nnot initial_value"];
    "SettingsEntryUpdateSelectionView" -> "SettingsEntryUpdateSelectionView" [style=dashed, color="#B0BEC5"];
    "SettingsSelectionRequiredWarningView" -> "SettingsEntryUpdateSelectionView" [];

    // Boundary transitions
    "ScanView" -> "SettingsIngestSettingsQRView" [style=dashed, color="#B0BEC5", label="decoder.is_complete  AND  NOT\n(decoder.is_seed)  AND  NOT (decoder.is_psbt)\nAND  decoder.is_settings"];
    "MainMenuView" -> "SettingsMenuView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] == SCAN)\nAND  NOT (button_data[selected_menu_num] ==\nSEEDS)  AND  NOT\n(button_data[selected_menu_num] == TOOLS)  AND\nbutton_data[selected_menu_num] == SETTINGS"];
    "NetworkMismatchErrorView" -> "SettingsEntryUpdateSelectionView" [style=dashed, color="#B0BEC5"];
    "OptionDisabledView" -> "SettingsEntryUpdateSelectionView" [style=dashed, color="#B0BEC5", label="button_data[selected_menu_num] ==\nUPDATE_SETTING"];
    "RemoveMicroSDWarningView" -> "SettingsEntryUpdateSelectionView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] ==\nCONTINUE)  AND  button_data[selected_menu_num]\n== SETTINGS"];
    "SettingsMenuView" -> "MainMenuView" [style=dashed, color="#B0BEC5", label="selected_menu_num == RET_CODE__BACK_BUTTON\nAND  visibility == VISIBILITY__GENERAL"];
    "SettingsMenuView" -> "IOTestView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] ==\nADVANCED)  AND  NOT\n(button_data[selected_menu_num] == HARDWARE)\nAND  button_data[selected_menu_num] == IO_TEST"];
    "SettingsMenuView" -> "DonateView" [style=dashed, color="#B0BEC5", label="NOT (button_data[selected_menu_num] ==\nADVANCED)  AND  NOT\n(button_data[selected_menu_num] == HARDWARE)\nAND  NOT (button_data[selected_menu_num] ==\nIO_TEST)  AND  button_data[selected_menu_num]\n== DONATE"];
    "SettingsEntryUpdateSelectionView" -> "blocking_view" [style=dashed, color="#B0BEC5", label="ret_value == RET_CODE__BACK_BUTTON  AND\nblocking_view"];
    "SettingsEntryUpdateSelectionView" -> "blocking_view" [style=dashed, color="#B0BEC5", label="blocking_view  AND  current_value ==\ninitial_value"];
    "SettingsEntryUpdateSelectionView" -> "unblocking_view" [style=dashed, color="#B0BEC5", label="blocking_view  AND  NOT (current_value ==\ninitial_value)  AND  unblocking_view"];
    "SettingsIngestSettingsQRView" -> "MainMenuView" [style=dashed, color="#B0BEC5"];
    "IOTestView" -> "SettingsMenuView" [style=dashed, color="#B0BEC5"];
    "DonateView" -> "SettingsMenuView" [style=dashed, color="#B0BEC5"];
}