    "SeedSignMessageConfirmMessageView" -> "[BACK]" [style=dashed, color="#B0BEC5", label="selected_menu_num == RET_CODE__BACK_BUTTON"];
    "SeedSignMessageConfirmAddressView" -> "NetworkMismatchErrorView" [style=dashed, color="#B0BEC5", label="addr_format['network'] != MAINNET  AND  NOT\n(settings.get_value(SETTING__NETWORK) in\n[TESTNET, REGTEST])"];
    "SeedSignMessageConfirmAddressView" -> "[BACK]" [style=dashed, color="#B0BEC5", label="selected_menu_num == RET_CODE__BACK_BUTTON"];
    "SeedSignMessageSignedMessageQRView" -> "MainMenuView" [style=dashed, color="#B0BEC5"];
}